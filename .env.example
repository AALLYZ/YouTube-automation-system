# ---- Core ----
APP_ENV=development
APP_SECRET_KEY=change-me-generate-32-random-bytes-base64
PUBLIC_HOST=http://localhost:3000
PORT=3000
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg://ytauto:ytauto@localhost:5433/ytauto
REDIS_URL=redis://localhost:6380/0
CORS_ORIGINS=http://localhost:5173

ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=set-a-strong-password

STORAGE_PROVIDER=local
STORAGE_LOCAL_ROOT=../storage

# ---- Provider selection: stub keeps the pipeline runnable with no keys ----
AI_PROVIDER=stub            # anthropic | openai | gemini | stub
RESEARCH_PROVIDER=stub      # tavily | brave | serpapi | stub
VOICE_PROVIDER=stub         # elevenlabs | openai | local | stub
IMAGE_PROVIDER=stub         # openai | stability | replicate | stub
VIDEO_CLIP_PROVIDER=stub    # replicate | stub
STOCK_PROVIDER=stub         # pexels | pixabay | stub
YOUTUBE_PROVIDER=stub       # google | stub
NOTIFIER_PROVIDER=console   # twilio | meta_cloud | console | stub

# ---- AI ----
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
GEMINI_API_KEY=

# ---- Research ----
TAVILY_API_KEY=
BRAVE_API_KEY=
SERPAPI_API_KEY=

# ---- Voice ----
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ---- Visuals ----
STABILITY_API_KEY=
REPLICATE_API_TOKEN=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ---- YouTube (OAuth 2.0 Web client) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT=http://localhost:3000/api/youtube/oauth/callback
YOUTUBE_DEFAULT_PRIVACY=private
YOUTUBE_DEFAULT_CATEGORY_ID=27

# ---- WhatsApp (Twilio) ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=whatsapp:+10000000000
TWILIO_STATUS_CALLBACK=

# ---- WhatsApp (Meta Cloud API) ----
META_WABA_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=

# ---- Storage (S3) ----
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ---- Automation / limits ----
SCHEDULER_ENABLED=false
JOBS_ASYNC=false            # true = enqueue pipeline runs to RQ (needs `make worker`)
MAX_CONCURRENT_JOBS=1
MAX_STAGE_RETRIES=3
RETRY_BACKOFF_BASE_SEC=10
DAILY_VIDEO_LIMIT=3
ARTIFACT_RETENTION_DAYS=30
YT_DAILY_QUOTA_UNITS=10000

# ---- Hardening ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_WRITE_PER_MIN=60
# WEB_DIST=                 # override the served dashboard build dir (default web/dist)
