# Copy to .env.prod (gitignored) and fill in. Used by docker-compose.prod.yml.

# ---- Core ----
APP_ENV=production
# generate: python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
APP_SECRET_KEY=
PUBLIC_HOST=https://your-domain.example
CORS_ORIGINS=https://your-domain.example
LOG_LEVEL=INFO

# ---- Database (compose sets DATABASE_URL from this) ----
POSTGRES_PASSWORD=
API_PORT=8000

# ---- Admin bootstrap (seeded on first boot) ----
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=

# ---- Automation ----
SCHEDULER_ENABLED=true
JOBS_ASYNC=true
MAX_CONCURRENT_JOBS=2
DAILY_VIDEO_LIMIT=3
ARTIFACT_RETENTION_DAYS=30

# ---- Hardening ----
RATE_LIMIT_ENABLED=true

# ---- Providers (stub keeps it runnable; swap in real ones + keys) ----
AI_PROVIDER=anthropic
RESEARCH_PROVIDER=tavily
VOICE_PROVIDER=elevenlabs
IMAGE_PROVIDER=openai
STOCK_PROVIDER=pexels
YOUTUBE_PROVIDER=google
NOTIFIER_PROVIDER=twilio

ANTHROPIC_API_KEY=
MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
TAVILY_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
PEXELS_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT=https://your-domain.example/api/youtube/oauth/callback

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
WHATSAPP_TO=whatsapp:+10000000000
TWILIO_STATUS_CALLBACK=https://your-domain.example/api/webhooks/twilio
